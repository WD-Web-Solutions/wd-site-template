APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/site_db
APP_CORS_ORIGINS=["http://localhost:4200"]
APP_JWT_SECRET_KEY=insecure-local-development-secret
APP_JWT_ALGORITHM=HS256
APP_JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
APP_BLOG_UPLOADS_DIR=uploads/blog
# Get a key at https://console.anthropic.com/settings/keys — the chat assistant
# returns 503 until this is set.
APP_ANTHROPIC_API_KEY=
APP_CHAT_MODEL=claude-opus-5
# Get test-mode keys at https://dashboard.stripe.com/test/apikeys — checkout
# returns 503 until APP_STRIPE_SECRET_KEY is set. The webhook secret comes from
# `stripe listen --forward-to localhost:8000/api/marketplace/webhook` (Stripe CLI).
APP_STRIPE_SECRET_KEY=
APP_STRIPE_WEBHOOK_SECRET=
APP_MARKETPLACE_CURRENCY=usd
APP_PUBLIC_SITE_URL=http://localhost:4200

APP_ENVIRONMENT=local
APP_LOG_LEVEL=INFO
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/site_db
APP_CORS_ORIGINS=["http://localhost:4200"]
APP_JWT_SECRET_KEY=insecure-local-development-secret
APP_JWT_ALGORITHM=HS256
APP_JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
APP_BLOG_UPLOADS_DIR=uploads/blog
